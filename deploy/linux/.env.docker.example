# ============================================================
# DeerFlow + sqlQuery Linux Docker 部署环境变量
#
# 使用方法：
#   cp .env.docker.example .env.docker
#   vim .env.docker  # 填实际值
#   docker compose --env-file .env.docker up -d
# ============================================================

# ---------- Docker compose 元配置 ----------

# 对外暴露端口（nginx 监听）。改这个避开宿主机 80 占用
EXPOSE_PORT=80

# 镜像标签（如已构建 sqlQuery backend 镜像）
SQLQUERY_BACKEND_IMAGE=dataagent-backend:latest

# sqlQuery 项目源码路径（LangGraph Server 容器需要挂载读取 langgraph.json）
# 支持相对路径（相对本 compose 文件）或绝对路径
SQLQUERY_PATH=../../Sdata/sqlQuery

# workspace 持久化目录（uploads、sandbox 生成文件、artifacts）
WORKSPACE_DIR=./data/workspace

# 受限网络用国内 npm 镜像；留空用官方 registry
NPM_REGISTRY=

# Better Auth secret（生产构建必须，任意非默认字符串）
BETTER_AUTH_SECRET=please-change-this-secret-in-env

# ---------- sqlQuery backend 配置（参考 sqlQuery/.env.docker）----------

# ---- 数据通系统库（数据源元信息 + 对话持久化 + LangGraph checkpointer）----
SYS_DATABASE_HOST=10.15.70.124
SYS_DATABASE_PORT=3307
SYS_DATABASE_USER=root
SYS_DATABASE_PASSWORD=change-me
SYS_DATABASE_NAME=sdata_sjt_c30

# ---- 数据源过滤条件 ----
DATAPP_ID=1409345383870331
SOURCE_TYPE=102

# ---- 数据通业务库 ----
YW_DATABASE_HOST=10.15.70.124
YW_DATABASE_PORT=3307
YW_DATABASE_USER=root
YW_DATABASE_PASSWORD=change-me
YW_DATABASE_NAME=sdata_sjt_c30_yewu

# ---- AES 密钥（解密数据源密码）----
AES_KEY=change-me
AES_IV=change-me

# ---- DeepSeek LLM ----
OPENAI_API_BASE=https://api.deepseek.com
OPENAI_API_KEY=sk-change-me
LLM_MODEL=openai:deepseek-v4-flash
# 思考模式（enabled/disabled），DeepSeek 需关闭避免 reasoning_content 回传报错
LLM_THINKING=disabled

# ---- 知识库表名 ----
KNO_TABLE_GLOSSARY=glossary
KNO_TABLE_METRICS=metrics

# ---- Milvus 向量库 ----
MILVUS_URI=http://10.15.60.119:19530
MILVUS_DB_NAME=kb_base_124
MILVUS_COLLECTIONS=sjt_glossary_embedding,sjt_metrics_embedding
MILVUS_TEXT_FIELD=text

# ---- 向量化模型 ----
EMBEDDING_API_URL=http://10.15.112.7:3027/api/v1.0/vectorizationTexts/service

# ---- 权限 API ----
PERMISSION_API_URL=https://10.15.70.124:58443
PERMISSION_CACHE_TTL=300
PERMISSION_API_VERIFY_SSL=false

# ---- Langfuse 可观测性（可选）----
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=
LANGFUSE_ENVIRONMENT=production

# ---- 图表功能开关 ----
SHOW_CHART=false

# ---------- 前端运行时配置（覆盖 .env.local）----------
# 这些值在镜像构建时已烘焙进 standalone 产物，运行时不需要再设。
# 仅留作记录，方便排查：

# NEXT_PUBLIC_BACKEND_BASE_URL=  # 空 → 同源访问 /api/*
# NEXT_PUBLIC_LANGGRAPH_BASE_URL= # 空 → 同源访问 /api/langgraph/*（nginx 重写为 /threads、/runs）
# SKIP_ENV_VALIDATION=1
# DEER_FLOW_AUTH_DISABLED=1
